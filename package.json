{
  "name": "segment-watchface",
  "author": "cmalec",
  "version": "0.0.1",
  "keywords": ["pebble-app", "pebble-watchface"],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "Segment",
    "uuid": "c3c75c5a-f27b-4686-920f-0bd79ef71277",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": ["emery"],
    "capabilities": [
      "configurable",
      "health",
      "location"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "blink",
      "invert",
      "bluetoothvibe",
      "bluetoothshow",
      "hourlyvibe",
      "branding_mask",
      "battery_hide",
      "battery_icon_only",
      "temp_unit",
      "seconds",
      "sleep_readout",
      "powersave",
      "ps_start",
      "ps_end",
      "switchset",
      "switch_start",
      "switch_end",
      "health",
      "wtemp_req",
      "wtemp_hi",
      "wtemp_lo",
      "pbatt_level",
      "setcolors",
      "set1colors",
      "set2colors",
      "date_format",
      "label_light",
      "label_font",
      "label_prev",
      "label_next",
      "wtemp_now",
      "wcond"
    ],
    "resources": {
      "media": [
        {
          "characterRegex": "[:0-9]",
          "file": "fonts/DS-Digital-Bold.ttf",
          "name": "FONT_DIGITALE_99",
          "type": "font",
          "targetPlatforms": ["emery"]
        },
        {
          "characterRegex": "[:0-9]",
          "file": "fonts/DS-Digital-Bold.ttf",
          "name": "FONT_DIGITALE_26",
          "type": "font",
          "targetPlatforms": ["emery"]
        },
        {
          "characterRegex": "[0-9 A-Za-z°%.:, --/' ~]",
          "file": "fonts/lucon.ttf",
          "name": "FONT_LUCIDIA_14",
          "type": "font",
          "targetPlatforms": ["emery"]
        },
        {
          "file": "images/logo_pebble.png",
          "name": "IMAGE_LOGO_PEBBLE",
          "type": "png"
        },
        {
          "file": "images/menu_icon_segment.png",
          "menuIcon": true,
          "name": "IMAGE_MENU_ICON",
          "type": "png"
        },
        {
          "characterRegex": "[ChronoV1Graph]",
          "file": "fonts/vollazee-font/Vollazee-2vx18.ttf",
          "name": "FONT_VOLLAZEE_16",
          "type": "font"
        },
        {
          "file": "fonts/weather-icons.ttf",
          "name": "WX_ICON_16",
          "type": "font",
          "characterRegex": "[\uf00d\uf02e\uf002\uf086\uf013\uf014\uf01c\uf019\uf01a\uf0b5\uf01b\uf01e]"
        }
      ]
    }
  }
}
